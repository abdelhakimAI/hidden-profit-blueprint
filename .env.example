# Copy this file to .env and fill in what you use. Everything here is
# optional — the page works with analytics fully disabled.

# Google Analytics 4 measurement ID, e.g. G-ABC1234XYZ. Leave blank to disable.
VITE_GA_MEASUREMENT_ID=

# Plausible Analytics domain, e.g. hiddenprofitwithaustin.com. Leave blank to disable.
VITE_PLAUSIBLE_DOMAIN=
