# Hashed JS/CSS bundles (filenames include a content hash) — safe to cache forever.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Unhashed public assets (the placeholder cover/OG image you'll swap in place) —
# short cache so a replaced file shows up quickly instead of being stuck for a year.
/assets/*.svg
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate
